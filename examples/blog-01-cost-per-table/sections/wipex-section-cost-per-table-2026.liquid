.wx-cpt__progress{position:fixed;top:0;left:0;right:0;height:3px;background:transparent;z-index:60;pointer-events:none}
.wx-cpt__progress-bar{height:100%;width:0;background:linear-gradient(90deg,var(--wx-accent),var(--wx-plum))}
.wx-cpt__sticky{position:fixed;left:0;right:0;bottom:0;z-index:70;display:flex;align-items:center;gap:.7rem;justify-content:center;
