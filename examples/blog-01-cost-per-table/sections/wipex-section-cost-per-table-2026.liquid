  padding:.55rem 1.05rem;font-size:.92rem;color:#fff}
.wx-cpt__op{color:rgba(255,255,255,.55)}
.wx-cpt__system-result{background:var(--wx-accent);border-color:var(--wx-accent);font-weight:700}

/* primary feature */
.wx-cpt__feature{display:grid;grid-template-columns:minmax(0,1fr);gap:1.4rem}
.wx-cpt__feature-media img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:var(--wx-radius);box-shadow:var(--wx-shadow)}
.wx-cpt__feature-list{margin:0 0 1.15rem;padding-left:1.1rem}
.wx-cpt__feature-list li::marker{color:var(--wx-accent)}

/* checklist */
.wx-cpt__check{background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-radius:var(--wx-radius);padding:1.15rem 1.3rem}
.wx-cpt__check-list{list-style:none;padding-left:0;margin:0}
.wx-cpt__check-item{display:flex;gap:.7rem;align-items:flex-start;margin:.6rem 0}
