.wx-cpt__cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1.1rem;margin-top:1.2rem}
.wx-cpt__card{border:1px solid var(--wx-line);border-radius:var(--wx-radius);background:var(--wx-surface);
