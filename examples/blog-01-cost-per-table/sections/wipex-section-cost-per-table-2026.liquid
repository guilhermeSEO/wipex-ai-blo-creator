  box-shadow:var(--wx-shadow);padding:1.35rem 1.45rem 1.5rem;margin:1.9rem 0}
.wx-cpt__sec-block h2{margin-top:0}

/* hero */
.wx-cpt__hero{background:var(--wx-hero-tint);border-bottom:1px solid var(--wx-line);padding:14px 0 38px}
.wx-cpt__hero-inner{max-width:46rem}
