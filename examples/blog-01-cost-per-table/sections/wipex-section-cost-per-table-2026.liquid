.wx-cpt__faqq{margin:2rem 0 .5rem;padding-top:1.1rem;border-top:1px solid var(--wx-line)}
.wx-cpt__faqq:first-of-type{border-top:0;padding-top:0;margin-top:1.5rem}
.wx-cpt__links{font-size:.95rem;background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-radius:var(--wx-radius);padding:1rem 1.15rem}
.wx-cpt__foot{color:var(--wx-muted);font-size:.82rem;letter-spacing:.02em}
.wx-cpt__hr{border:0;border-top:1px solid var(--wx-line);margin:2.2rem 0}
.wx-cpt__code{background:var(--wx-dark);color:#f4f4f2;border:0;border-radius:var(--wx-radius-sm);padding:1rem 1.1rem;
  overflow-x:auto;font-size:.9rem;line-height:1.55;margin:0 0 1.2rem}
.wx-cpt__code code{background:none;border:0;padding:0;color:inherit}
.wx-cpt__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wx-cpt__sec--final .wx-cpt__read{background:var(--wx-surface-warm);border:1px solid var(--wx-line);
