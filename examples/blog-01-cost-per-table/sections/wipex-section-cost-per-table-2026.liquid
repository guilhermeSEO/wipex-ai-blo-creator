.wx-cpt__check-note{margin:.95rem 0 0;font-size:.78rem;color:var(--wx-muted)}

/* calculator */
.wx-cpt__calc{background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-left:4px solid var(--wx-accent);
  border-radius:var(--wx-radius);padding:1.3rem 1.35rem 1.2rem;margin:1.7rem 0 1.9rem;contain:content}
.wx-cpt__calc-h{margin:0 0 1rem;font-size:1.1rem}
