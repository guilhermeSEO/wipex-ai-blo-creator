.wx-cpt__card-h{margin:0 0 .35rem;font-size:1.08rem}
.wx-cpt__card-best{margin:0 0 .7rem;font-size:.85rem;color:var(--wx-muted)}
.wx-cpt__card-list{margin:0 0 1.15rem;padding-left:1.1rem;font-size:.92rem}
.wx-cpt__card .wx-cpt__btn{margin-top:auto;align-self:flex-start}

