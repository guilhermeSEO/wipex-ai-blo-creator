  transition:box-shadow .15s ease,transform .15s ease}
.wx-cpt__card:hover{box-shadow:var(--wx-shadow-hover);transform:translateY(-2px)}
.wx-cpt__card-media img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:var(--wx-radius-sm);margin-bottom:.85rem}
.wx-cpt__badge{align-self:flex-start;font-size:.7rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;
