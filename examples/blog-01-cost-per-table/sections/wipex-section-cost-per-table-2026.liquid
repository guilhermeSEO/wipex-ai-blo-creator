.wx-cpt__dec-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1.1rem;margin-top:1.2rem}
.wx-cpt__dec{border:1px solid var(--wx-line);border-radius:var(--wx-radius);background:var(--wx-surface-warm);
