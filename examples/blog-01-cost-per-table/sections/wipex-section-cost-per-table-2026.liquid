/* buttons */
.wx-cpt__btn{display:inline-flex;align-items:center;font-weight:700;font-size:.95rem;line-height:1;text-decoration:none;
  padding:.9rem 1.4rem;border-radius:var(--wx-pill);border:1.5px solid transparent;
  transition:transform .15s ease,box-shadow .15s ease,background .15s ease,color .15s ease,border-color .15s ease}
.wx-cpt a.wx-cpt__btn--primary{background:var(--wx-accent);color:#fff;box-shadow:0 8px 18px rgba(118,195,156,.3)}
.wx-cpt a.wx-cpt__btn--primary:hover{transform:translateY(-1px);box-shadow:0 12px 26px rgba(118,195,156,.36);color:#fff}
.wx-cpt a.wx-cpt__btn--gold{background:var(--wx-plum);color:#fff;box-shadow:0 8px 18px rgba(182,143,189,.32)}
