/* info cards */
.wx-cpt__info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1rem;margin-top:1.15rem}
.wx-cpt__card-info{background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-radius:var(--wx-radius);
