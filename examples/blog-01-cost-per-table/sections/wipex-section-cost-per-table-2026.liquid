<style>
/* ============================================================================
   Wipex blog section — stylesheet  (kept inside <style> so nothing renders as text)

   Design belongs here; logic belongs in build_shopify_paste.py. Two tokens are
   substituted at build time:

     wx-cpt          -> the post's CSS prefix (e.g. wx-cpt), so every rule is scoped
                     to the section and cannot leak into the theme
     .wx-cpt{--wx-ink:#1c1d1d;--wx-ink-soft:#4a4a48;--wx-muted:#6f6f6b;--wx-line:#e8e8e1;--wx-surface:#ffffff;--wx-surface-warm:#fdfbf8;--wx-dark:#111111;--wx-accent:#76c39c;--wx-accent-ink:#2f6b4f;--wx-accent-soft:#eaf6f0;--wx-plum:#b68fbd;--wx-plum-soft:#f5eef7;--wx-gold:#b08d57;--wx-radius:16px;--wx-radius-sm:6px;--wx-pill:999px;--wx-shadow:0 1px 2px rgba(28,29,29,.05), 0 10px 30px rgba(28,29,29,.06);--wx-shadow-hover:0 2px 6px rgba(28,29,29,.07), 0 18px 44px rgba(28,29,29,.11);--wx-maxw:1180px;--wx-readw:44rem;--wx-space:28px;--wx-hero-tint:linear-gradient(180deg, #fdfbf8 0%, #ffffff 78%);--wx-font-head:"New Order", Raleway, system-ui, -apple-system, Segoe UI, sans-serif;font-family:Raleway, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;color:var(--wx-ink);line-height:1.65;font-size:1.0625rem;text-rendering:optimizeLegibility;position:relative;-webkit-font-smoothing:antialiased}   -> the palette/typography block generated from "theme" in
                     SHOPIFY-CONFIG.json

   To restyle a post or a season: edit the `theme` block in the config. Do not
   write a colour, a font or a radius in this file — only var(--wx-*).
   ============================================================================ */
.wx-cpt{--wx-ink:#1c1d1d;--wx-ink-soft:#4a4a48;--wx-muted:#6f6f6b;--wx-line:#e8e8e1;--wx-surface:#ffffff;--wx-surface-warm:#fdfbf8;--wx-dark:#111111;--wx-accent:#76c39c;--wx-accent-ink:#2f6b4f;--wx-accent-soft:#eaf6f0;--wx-plum:#b68fbd;--wx-plum-soft:#f5eef7;--wx-gold:#b08d57;--wx-radius:16px;--wx-radius-sm:6px;--wx-pill:999px;--wx-shadow:0 1px 2px rgba(28,29,29,.05), 0 10px 30px rgba(28,29,29,.06);--wx-shadow-hover:0 2px 6px rgba(28,29,29,.07), 0 18px 44px rgba(28,29,29,.11);--wx-maxw:1180px;--wx-readw:44rem;--wx-space:28px;--wx-hero-tint:linear-gradient(180deg, #fdfbf8 0%, #ffffff 78%);--wx-font-head:"New Order", Raleway, system-ui, -apple-system, Segoe UI, sans-serif;font-family:Raleway, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;color:var(--wx-ink);line-height:1.65;font-size:1.0625rem;text-rendering:optimizeLegibility;position:relative;-webkit-font-smoothing:antialiased}
