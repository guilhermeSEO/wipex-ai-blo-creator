.wx-cpt__dec-arrow{color:var(--wx-accent);margin:.25rem 0}
.wx-cpt__dec-sol{font-family:var(--wx-font-head);font-weight:700;margin:0 0 .9rem}

/* A + B system block — the dark card, straight from the store's own card style */
.wx-cpt__system{background:var(--wx-dark);border-color:var(--wx-dark);color:#fff;text-align:center}
.wx-cpt__system h2{color:#fff}
.wx-cpt__system p{color:rgba(255,255,255,.78)}
