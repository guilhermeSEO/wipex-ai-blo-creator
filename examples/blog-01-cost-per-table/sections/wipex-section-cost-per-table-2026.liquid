.wx-cpt a.wx-cpt__btn--ghost{background:var(--wx-surface);color:var(--wx-ink);border-color:var(--wx-line);box-shadow:var(--wx-shadow)}
.wx-cpt a.wx-cpt__btn--ghost:hover{border-color:var(--wx-accent);color:var(--wx-accent-ink)}
.wx-cpt__btn--sm{padding:.62rem 1.05rem;font-size:.875rem}

/* editorial media */
.wx-cpt__band{margin:1.6rem 0}
.wx-cpt__band img{object-position:var(--wx-cpt-img-pos,center)}
.wx-cpt__band.wx-cpt__life--16x9 img{aspect-ratio:16/9;object-fit:cover;width:100%;border-radius:var(--wx-radius);box-shadow:var(--wx-shadow)}
.wx-cpt__life--2x3 img{aspect-ratio:2/3;object-fit:cover;width:100%;max-width:420px;border-radius:var(--wx-radius);box-shadow:var(--wx-shadow)}
.wx-cpt__band.wx-cpt__life--2x3 .wx-cpt__wrap{max-width:480px}
.wx-cpt__cap{display:block;color:var(--wx-muted);font-size:.8rem;letter-spacing:.02em;margin-top:.55rem}
.wx-cpt__ph{border:1px dashed var(--wx-line);border-radius:var(--wx-radius);color:var(--wx-muted);font-size:.85rem;
  text-align:center;padding:2.5rem 1rem;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;
  background:repeating-linear-gradient(45deg,var(--wx-surface-warm),var(--wx-surface-warm) 10px,#f6f3ee 10px,#f6f3ee 20px)}
.wx-cpt__liferow{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:1.9rem;align-items:start;
  max-width:var(--wx-maxw);margin-inline:auto;padding:0 22px}
.wx-cpt__liferow .wx-cpt__read{margin-inline:0;max-width:none}
.wx-cpt__band--row{margin:0}
.wx-cpt__band--row img{border-radius:var(--wx-radius);box-shadow:var(--wx-shadow)}

/* video band */
.wx-cpt__videoband{padding:var(--wx-space) 0}
.wx-cpt__video{position:relative;border-radius:var(--wx-radius);overflow:hidden;background:var(--wx-dark);box-shadow:var(--wx-shadow)}
.wx-cpt__video video,.wx-cpt__video img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.wx-cpt__video-content{position:absolute;inset:auto 0 0 0;padding:1.6rem;color:#fff;
  background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(17,17,17,.72) 100%)}
.wx-cpt__video-h{margin:0 0 .35rem;color:#fff;font-size:1.3rem}
.wx-cpt__video-t{margin:0 0 .9rem;color:#f2f2f2;font-size:.95rem}

/* key takeaways */
.wx-cpt__takeaways{list-style:none;padding:1.3rem 1.4rem;margin:1.4rem 0 1.6rem;background:var(--wx-accent-soft);
  border-left:4px solid var(--wx-accent);border-radius:0 var(--wx-radius) var(--wx-radius) 0}
.wx-cpt__takeaways li{position:relative;padding-left:1.6rem;margin:.55rem 0}
.wx-cpt__takeaways li::before{content:"\2713";position:absolute;left:0;color:var(--wx-accent-ink);font-weight:700}

/* table of contents */
.wx-cpt__toc{border:1px solid var(--wx-line);border-radius:var(--wx-radius);background:var(--wx-surface);
  box-shadow:var(--wx-shadow);margin:1.4rem 0 1.9rem;overflow:hidden}
.wx-cpt__toc-head{display:flex;justify-content:space-between;align-items:center;width:100%;gap:.75rem;
  font-family:var(--wx-font-head);font-weight:700;font-size:.95rem;text-align:left;background:none;border:0;
  cursor:pointer;padding:1rem 1.15rem;color:var(--wx-ink)}
.wx-cpt__toc-chev{transition:transform .18s ease;color:var(--wx-accent)}
.wx-cpt__toc[data-open="false"] .wx-cpt__toc-chev{transform:rotate(-90deg)}
.wx-cpt__toc[data-open="false"] .wx-cpt__toc-list{display:none}
.wx-cpt__toc-list{list-style:none;margin:0;padding:.35rem 1.15rem 1.1rem;border-top:1px solid var(--wx-line)}
.wx-cpt__toc-list li{margin:.45rem 0}
.wx-cpt__toc-list a{text-decoration:none;font-size:.95rem}

/* tables */
.wx-cpt__tablewrap{overflow-x:auto;margin:0 0 1.4rem;border:1px solid var(--wx-line);border-radius:var(--wx-radius);
  box-shadow:var(--wx-shadow);background:var(--wx-surface)}
.wx-cpt__table{border-collapse:collapse;width:100%;font-size:.965rem}
.wx-cpt__table--wide{min-width:34rem}
.wx-cpt__table th,.wx-cpt__table td{padding:.7rem .9rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--wx-line)}
.wx-cpt__table thead th{background:var(--wx-accent-soft);color:var(--wx-accent-ink);font-weight:700;white-space:nowrap}
.wx-cpt__table tbody tr:nth-child(even){background:var(--wx-surface-warm)}
.wx-cpt__table tbody tr:last-child td,.wx-cpt__table tbody tr:last-child th{border-bottom:0}
.wx-cpt__table tbody th{font-weight:700}

/* problem strip */
.wx-cpt__strip{background:var(--wx-dark);color:#fff;margin:0 0 6px}
.wx-cpt__strip-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1px;background:rgba(255,255,255,.14)}
.wx-cpt__strip-cell{background:var(--wx-dark);padding:1.15rem 1.25rem}
.wx-cpt__strip-cell strong{display:block;font-family:var(--wx-font-head);font-size:1rem;color:#fff}
.wx-cpt__strip-cell span{display:block;color:rgba(255,255,255,.72);font-size:.85rem;margin-top:.25rem}

/* stat cards */
.wx-cpt__stats-block{padding:var(--wx-space) 0 0}
.wx-cpt__stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:.85rem;margin:1.1rem 0 0}
.wx-cpt__stat{background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-radius:var(--wx-radius);padding:1rem 1.05rem}
