.wx-cpt img{max-width:100%;height:auto;display:block}
.wx-cpt h1,.wx-cpt h2,.wx-cpt h3{font-family:var(--wx-font-head);line-height:1.18;letter-spacing:-.015em;color:var(--wx-ink);margin:0 0 .6em}
