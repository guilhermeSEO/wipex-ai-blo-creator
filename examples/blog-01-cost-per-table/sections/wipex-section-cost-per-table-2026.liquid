.wx-cpt__calc-grid input{font:inherit;font-size:.95rem;color:var(--wx-ink);padding:.55rem .6rem;border:1px solid var(--wx-line);
  border-radius:var(--wx-radius-sm);background:var(--wx-surface);min-width:0}
.wx-cpt__calc-grid input:focus{outline:2px solid var(--wx-accent);outline-offset:1px;border-color:var(--wx-accent)}
