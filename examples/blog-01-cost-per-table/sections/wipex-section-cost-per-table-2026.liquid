  box-shadow:0 -8px 26px rgba(17,17,17,.22);transform:translateY(110%);transition:transform .2s ease}
.wx-cpt__sticky.is-visible{transform:translateY(0)}
.wx-cpt__sticky .wx-cpt__btn--primary{box-shadow:none;padding:.7rem 1.15rem}
.wx-cpt__sticky-close{background:none;border:0;font-size:1.4rem;line-height:1;color:rgba(255,255,255,.7);cursor:pointer;padding:.1rem .45rem}
.wx-cpt__sticky-close:hover{color:#fff}

