{%- comment -%}
  Wipex blog section — wipex-section-multi-location-procurement-2026.
  Reference-grade module: theme-editor settings, editorial media (16:9 / 2:3 stills, native video
  band), interactive TOC, real checklist, reading progress, sticky mobile CTA, data-cro on every
  CTA, instance-safe JavaScript (safe to place twice on one page).

  The prose below is GENERATED from the compliance-approved markdown. Do not retype it in the
  editor: edit the markdown, regenerate, re-paste. The prose may not contain Liquid delimiters —
  the generator refuses to emit a section when it does.

  Structured data is NOT in this file: Shopify's validator counts every @type key in the file as a
  setting and blows the 40-setting cap. It lives in snippets/wipex-blog-schema.liquid.

  Files in the theme:
    sections/wipex-section-multi-location-procurement-2026.liquid
    snippets/wipex-blog-schema.liquid
    templates/article.multi-location-procurement.json
{%- endcomment -%}

{%- assign uid = section.id -%}
{% raw %}
<style>
/* ============================================================================
   Wipex blog section — stylesheet  (kept inside <style> so nothing renders as text)

   Design belongs here; logic belongs in build_shopify_paste.py. Two tokens are
   substituted at build time:

     wx-mlp          -> the post's CSS prefix (e.g. wx-cpt), so every rule is scoped
                     to the section and cannot leak into the theme
     .wx-mlp{--wx-ink:#1c1d1d;--wx-ink-soft:#4a4a48;--wx-muted:#6f6f6b;--wx-line:#e8e8e1;--wx-surface:#ffffff;--wx-surface-warm:#fdfbf8;--wx-dark:#111111;--wx-band:#3a2740;--wx-band-alt:#251730;--wx-accent:#76c39c;--wx-accent-ink:#2f6b4f;--wx-accent-soft:#eaf6f0;--wx-plum:#b68fbd;--wx-plum-soft:#f5eef7;--wx-gold:#b08d57;--wx-radius:16px;--wx-radius-sm:6px;--wx-pill:999px;--wx-shadow:0 1px 2px rgba(28,29,29,.05), 0 10px 30px rgba(28,29,29,.06);--wx-shadow-hover:0 2px 6px rgba(28,29,29,.07), 0 18px 44px rgba(28,29,29,.11);--wx-maxw:1180px;--wx-readw:44rem;--wx-space:28px;--wx-hero-tint:linear-gradient(180deg, #fdfbf8 0%, #ffffff 78%);--wx-font-head:"New Order", Raleway, system-ui, -apple-system, Segoe UI, sans-serif;font-family:Raleway, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;color:var(--wx-ink);line-height:1.65;font-size:1.0625rem;text-rendering:optimizeLegibility;position:relative;-webkit-font-smoothing:antialiased}   -> the palette/typography block generated from "theme" in
                     SHOPIFY-CONFIG.json

   To restyle a post or a season: edit the `theme` block in the config. Do not
   write a colour, a font or a radius in this file — only var(--wx-*).
   ============================================================================ */
.wx-mlp{--wx-ink:#1c1d1d;--wx-ink-soft:#4a4a48;--wx-muted:#6f6f6b;--wx-line:#e8e8e1;--wx-surface:#ffffff;--wx-surface-warm:#fdfbf8;--wx-dark:#111111;--wx-band:#3a2740;--wx-band-alt:#251730;--wx-accent:#76c39c;--wx-accent-ink:#2f6b4f;--wx-accent-soft:#eaf6f0;--wx-plum:#b68fbd;--wx-plum-soft:#f5eef7;--wx-gold:#b08d57;--wx-radius:16px;--wx-radius-sm:6px;--wx-pill:999px;--wx-shadow:0 1px 2px rgba(28,29,29,.05), 0 10px 30px rgba(28,29,29,.06);--wx-shadow-hover:0 2px 6px rgba(28,29,29,.07), 0 18px 44px rgba(28,29,29,.11);--wx-maxw:1180px;--wx-readw:44rem;--wx-space:28px;--wx-hero-tint:linear-gradient(180deg, #fdfbf8 0%, #ffffff 78%);--wx-font-head:"New Order", Raleway, system-ui, -apple-system, Segoe UI, sans-serif;font-family:Raleway, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;color:var(--wx-ink);line-height:1.65;font-size:1.0625rem;text-rendering:optimizeLegibility;position:relative;-webkit-font-smoothing:antialiased}
.wx-mlp *,.wx-mlp *::before,.wx-mlp *::after{box-sizing:border-box}
.wx-mlp img{max-width:100%;height:auto;display:block}
.wx-mlp h1,.wx-mlp h2,.wx-mlp h3{font-family:var(--wx-font-head);line-height:1.18;letter-spacing:-.015em;color:var(--wx-ink);margin:0 0 .6em}
.wx-mlp h1{font-size:clamp(1.95rem,1.3rem + 2.6vw,3rem)}
.wx-mlp h2{font-size:clamp(1.4rem,1.15rem + 1.1vw,1.9rem)}
.wx-mlp h3{font-size:1.15rem}
.wx-mlp p{margin:0 0 1.1rem}
.wx-mlp ul,.wx-mlp ol{margin:0 0 1.2rem;padding-left:1.3rem}
.wx-mlp li{margin:.4rem 0}
.wx-mlp a{color:var(--wx-accent-ink);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
.wx-mlp a:hover{color:var(--wx-accent);text-decoration-thickness:2px}
.wx-mlp a.wx-mlp__btn{text-decoration:none}
.wx-mlp strong{font-weight:700}
.wx-mlp code{background:var(--wx-surface-warm);border:1px solid var(--wx-line);padding:.1em .4em;border-radius:var(--wx-radius-sm);font-size:.9em}
.wx-mlp :focus-visible{outline:2px solid var(--wx-accent);outline-offset:2px;border-radius:4px}
.wx-mlp__wrap{max-width:var(--wx-maxw);margin-inline:auto;padding:0 22px}
.wx-mlp__read{max-width:var(--wx-readw);margin-inline:auto}
.wx-mlp__sec{padding:var(--wx-space) 0;border-top:1px solid var(--wx-line)}
.wx-mlp__sec:first-of-type{border-top:0}
.wx-mlp__sec-block{background:var(--wx-surface);border:1px solid var(--wx-line);border-radius:var(--wx-radius);
  box-shadow:var(--wx-shadow);padding:1.35rem 1.45rem 1.5rem;margin:1.9rem 0}
.wx-mlp__sec-block h2{margin-top:0}

/* hero */
.wx-mlp__hero{background:var(--wx-hero-tint);border-bottom:1px solid var(--wx-line);padding:14px 0 38px}
.wx-mlp__hero-inner{max-width:46rem}
.wx-mlp__eyebrow{display:inline-block;font-size:.74rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  color:var(--wx-accent-ink);background:var(--wx-accent-soft);border-radius:var(--wx-pill);padding:.38rem .85rem;margin-bottom:18px}
.wx-mlp__lede{font-size:1.12rem;color:var(--wx-ink-soft);max-width:44rem}
.wx-mlp__lede p:last-child{margin-bottom:1.1rem}
.wx-mlp__cta-row{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center;margin:1.6rem 0 0}

/* buttons */
.wx-mlp__btn{display:inline-flex;align-items:center;font-weight:700;font-size:.95rem;line-height:1;text-decoration:none;
  padding:.9rem 1.4rem;border-radius:var(--wx-pill);border:1.5px solid transparent;
  transition:transform .15s ease,box-shadow .15s ease,background .15s ease,color .15s ease,border-color .15s ease}
.wx-mlp a.wx-mlp__btn--primary{background:var(--wx-accent);color:#fff;box-shadow:0 8px 18px rgba(118,195,156,.3)}
.wx-mlp a.wx-mlp__btn--primary:hover{transform:translateY(-1px);box-shadow:0 12px 26px rgba(118,195,156,.36);color:#fff}
.wx-mlp a.wx-mlp__btn--gold{background:var(--wx-plum);color:#fff;box-shadow:0 8px 18px rgba(182,143,189,.32)}
.wx-mlp a.wx-mlp__btn--gold:hover{transform:translateY(-1px);color:#fff}
.wx-mlp a.wx-mlp__btn--ghost{background:var(--wx-surface);color:var(--wx-ink);border-color:var(--wx-line);box-shadow:var(--wx-shadow)}
.wx-mlp a.wx-mlp__btn--ghost:hover{border-color:var(--wx-accent);color:var(--wx-accent-ink)}
.wx-mlp__btn--sm{padding:.62rem 1.05rem;font-size:.875rem}

/* editorial media */
.wx-mlp__band{margin:1.6rem 0}
.wx-mlp__band img{object-position:var(--wx-mlp-img-pos,center)}
.wx-mlp__band.wx-mlp__life--16x9 img{aspect-ratio:16/9;object-fit:cover;width:100%;border-radius:var(--wx-radius);box-shadow:var(--wx-shadow)}
.wx-mlp__life--2x3 img{aspect-ratio:2/3;object-fit:cover;width:100%;max-width:420px;border-radius:var(--wx-radius);box-shadow:var(--wx-shadow)}
.wx-mlp__band.wx-mlp__life--2x3 .wx-mlp__wrap{max-width:480px}
.wx-mlp__cap{display:block;color:var(--wx-muted);font-size:.8rem;letter-spacing:.02em;margin-top:.55rem}
.wx-mlp__ph{border:1px dashed var(--wx-accent);border-radius:var(--wx-radius);color:var(--wx-accent-ink);font-size:.85rem;
  text-align:center;padding:2rem 1.1rem;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;
  background:var(--wx-accent-soft);font-weight:600;letter-spacing:.01em}
.wx-mlp__liferow{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:1.9rem;align-items:start;
  max-width:var(--wx-maxw);margin-inline:auto;padding:0 22px}
.wx-mlp__liferow .wx-mlp__read{margin-inline:0;max-width:none}
.wx-mlp__band--row{margin:0}
.wx-mlp__band--row img{border-radius:var(--wx-radius);box-shadow:var(--wx-shadow)}

/* video band */
.wx-mlp__videoband{padding:var(--wx-space) 0}
.wx-mlp__video{position:relative;border-radius:var(--wx-radius);overflow:hidden;background:var(--wx-band);box-shadow:var(--wx-shadow)}
.wx-mlp__video video,.wx-mlp__video img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.wx-mlp__video-content{position:absolute;inset:auto 0 0 0;padding:1.6rem;color:#fff;
  background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(17,17,17,.72) 100%)}
.wx-mlp__video-h{margin:0 0 .35rem;color:#fff;font-size:1.3rem}
.wx-mlp__video-t{margin:0 0 .9rem;color:#f2f2f2;font-size:.95rem}

/* key takeaways */
.wx-mlp__takeaways{list-style:none;padding:1.3rem 1.4rem;margin:1.4rem 0 1.6rem;background:var(--wx-accent-soft);
  border-left:4px solid var(--wx-accent);border-radius:0 var(--wx-radius) var(--wx-radius) 0}
.wx-mlp__takeaways li{position:relative;padding-left:1.6rem;margin:.55rem 0}
.wx-mlp__takeaways li::before{content:"\2713";position:absolute;left:0;color:var(--wx-accent-ink);font-weight:700}

/* table of contents */
.wx-mlp__toc{border:1px solid var(--wx-line);border-radius:var(--wx-radius);background:var(--wx-surface);
  box-shadow:var(--wx-shadow);margin:1.4rem 0 1.9rem;overflow:hidden}
.wx-mlp__toc-head{display:flex;justify-content:space-between;align-items:center;width:100%;gap:.75rem;
  font-family:var(--wx-font-head);font-weight:700;font-size:.95rem;text-align:left;background:none;border:0;
  cursor:pointer;padding:1rem 1.15rem;color:var(--wx-ink)}
.wx-mlp__toc-chev{transition:transform .18s ease;color:var(--wx-accent)}
.wx-mlp__toc[data-open="false"] .wx-mlp__toc-chev{transform:rotate(-90deg)}
.wx-mlp__toc[data-open="false"] .wx-mlp__toc-list{display:none}
.wx-mlp__toc-list{list-style:none;margin:0;padding:.35rem 1.15rem 1.1rem;border-top:1px solid var(--wx-line)}
.wx-mlp__toc-list li{margin:.45rem 0}
.wx-mlp__toc-list a{text-decoration:none;font-size:.95rem}

/* tables */
.wx-mlp__tablewrap{overflow-x:auto;margin:0 0 1.4rem;border:1px solid var(--wx-line);border-radius:var(--wx-radius);
  box-shadow:var(--wx-shadow);background:var(--wx-surface)}
.wx-mlp__table{border-collapse:collapse;width:100%;font-size:.965rem}
.wx-mlp__table--wide{min-width:34rem}
.wx-mlp__table th,.wx-mlp__table td{padding:.7rem .9rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--wx-line)}
.wx-mlp__table thead th{background:var(--wx-accent-soft);color:var(--wx-accent-ink);font-weight:700;white-space:nowrap}
.wx-mlp__table tbody tr:nth-child(even){background:var(--wx-surface-warm)}
.wx-mlp__table tbody tr:last-child td,.wx-mlp__table tbody tr:last-child th{border-bottom:0}
.wx-mlp__table tbody th{font-weight:700}

/* problem strip — same illuminated palette, cells separated by a hairline */
.wx-mlp__strip{background:var(--wx-accent-soft);color:var(--wx-ink);margin:0 0 6px}
.wx-mlp__strip-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1px;background:var(--wx-line)}
.wx-mlp__strip-cell{background:var(--wx-surface);padding:1.15rem 1.25rem}
.wx-mlp__strip-cell strong{display:block;font-family:var(--wx-font-head);font-size:1rem;color:var(--wx-ink)}
.wx-mlp__strip-cell span{display:block;color:var(--wx-ink-soft);font-size:.85rem;margin-top:.25rem}

/* stat cards */
.wx-mlp__stats-block{padding:var(--wx-space) 0 0}
.wx-mlp__stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:.85rem;margin:1.1rem 0 0}
.wx-mlp__stat{background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-radius:var(--wx-radius);padding:1rem 1.05rem}
.wx-mlp__stat b{display:block;font-family:var(--wx-font-head);font-size:1.75rem;letter-spacing:-.02em;color:var(--wx-accent-ink)}
.wx-mlp__stat span{display:block;color:var(--wx-muted);font-size:.8rem;margin-top:.2rem}

/* info cards */
.wx-mlp__info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1rem;margin-top:1.15rem}
.wx-mlp__card-info{background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-radius:var(--wx-radius);
  padding:1.05rem 1.1rem;box-shadow:var(--wx-shadow);transition:box-shadow .15s ease,transform .15s ease}
.wx-mlp__card-info:hover{box-shadow:var(--wx-shadow-hover);transform:translateY(-2px)}
.wx-mlp__card-info h3{margin:0 0 .35rem;font-size:1.02rem}
.wx-mlp__card-info p{margin:0;font-size:.92rem;color:var(--wx-muted)}
.wx-mlp__note{font-size:.85rem;color:var(--wx-muted);margin:1rem 0 0}

/* product cards */
.wx-mlp__cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1.1rem;margin-top:1.2rem}
.wx-mlp__card{border:1px solid var(--wx-line);border-radius:var(--wx-radius);background:var(--wx-surface);
  padding:1.15rem 1.2rem 1.3rem;display:flex;flex-direction:column;box-shadow:var(--wx-shadow);
  transition:box-shadow .15s ease,transform .15s ease}
.wx-mlp__card:hover{box-shadow:var(--wx-shadow-hover);transform:translateY(-2px)}
.wx-mlp__card-media img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:var(--wx-radius-sm);margin-bottom:.85rem}
.wx-mlp__badge{align-self:flex-start;font-size:.7rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;
  color:var(--wx-plum);background:var(--wx-plum-soft);border-radius:var(--wx-pill);padding:.3rem .7rem;margin-bottom:.7rem}
.wx-mlp__card-h{margin:0 0 .35rem;font-size:1.08rem}
.wx-mlp__card-best{margin:0 0 .7rem;font-size:.85rem;color:var(--wx-muted)}
.wx-mlp__card-list{margin:0 0 1.15rem;padding-left:1.1rem;font-size:.92rem}
.wx-mlp__card .wx-mlp__btn{margin-top:auto;align-self:flex-start}

/* decision tool */
.wx-mlp__dec-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1.1rem;margin-top:1.2rem}
.wx-mlp__dec{border:1px solid var(--wx-line);border-radius:var(--wx-radius);background:var(--wx-surface-warm);
  padding:1.15rem 1.2rem;text-align:center;transition:box-shadow .15s ease,transform .15s ease}
.wx-mlp__dec:hover{transform:translateY(-2px);box-shadow:var(--wx-shadow-hover)}
.wx-mlp__dec--rec{background:var(--wx-surface);border-color:var(--wx-accent);box-shadow:inset 0 0 0 1px var(--wx-accent),var(--wx-shadow)}
.wx-mlp__dec h3{margin:0 0 .4rem;font-size:1.02rem}
.wx-mlp__dec-arrow{color:var(--wx-accent);margin:.25rem 0}
.wx-mlp__dec-sol{font-family:var(--wx-font-head);font-weight:700;margin:0 0 .9rem}

/* A + B system block — the closing band's illuminated palette on a card */
.wx-mlp__system{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--wx-accent-soft) 0%,var(--wx-surface) 58%,var(--wx-plum-soft) 100%);border-color:var(--wx-line);color:var(--wx-ink);text-align:center}
.wx-mlp__system::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--wx-accent),var(--wx-plum))}
.wx-mlp__system h2{color:var(--wx-ink)}
.wx-mlp__system p{color:var(--wx-ink-soft)}
.wx-mlp__system-eq{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;align-items:center;margin:1.25rem 0}
.wx-mlp__pill{background:var(--wx-surface);border:1px solid var(--wx-line);border-radius:var(--wx-pill);
  padding:.55rem 1.05rem;font-size:.92rem;color:var(--wx-ink)}
.wx-mlp__op{color:var(--wx-muted)}
.wx-mlp__system-result{background:var(--wx-accent);border-color:var(--wx-accent);color:#fff;font-weight:700}

/* primary feature */
.wx-mlp__feature{display:grid;grid-template-columns:minmax(0,1fr);gap:1.4rem}
.wx-mlp__feature-media img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:var(--wx-radius);box-shadow:var(--wx-shadow)}
.wx-mlp__feature-list{margin:0 0 1.15rem;padding-left:1.1rem}
.wx-mlp__feature-list li::marker{color:var(--wx-accent)}

/* checklist */
.wx-mlp__check{background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-radius:var(--wx-radius);padding:1.15rem 1.3rem}
.wx-mlp__check-list{list-style:none;padding-left:0;margin:0}
.wx-mlp__check-item{display:flex;gap:.7rem;align-items:flex-start;margin:.6rem 0}
.wx-mlp__check-item input{margin:.28rem 0 0;width:1.15rem;height:1.15rem;accent-color:var(--wx-accent);flex:none}
.wx-mlp__check-item label{cursor:pointer}
.wx-mlp__check-item input:checked + label{color:var(--wx-muted);text-decoration:line-through}
.wx-mlp__check-note{margin:.95rem 0 0;font-size:.78rem;color:var(--wx-muted)}

/* calculator */
.wx-mlp__calc{background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-left:4px solid var(--wx-accent);
  border-radius:var(--wx-radius);padding:1.3rem 1.35rem 1.2rem;margin:1.7rem 0 1.9rem;contain:content}
.wx-mlp__calc-h{margin:0 0 1rem;font-size:1.1rem}
.wx-mlp__calc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.8rem}
.wx-mlp__calc-grid label{display:flex;flex-direction:column;gap:.3rem;font-size:.8rem;color:var(--wx-muted)}
.wx-mlp__calc-grid input{font:inherit;font-size:.95rem;color:var(--wx-ink);padding:.55rem .6rem;border:1px solid var(--wx-line);
  border-radius:var(--wx-radius-sm);background:var(--wx-surface);min-width:0}
.wx-mlp__calc-grid input:focus{outline:2px solid var(--wx-accent);outline-offset:1px;border-color:var(--wx-accent)}
.wx-mlp__calc-out{display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:.8rem;margin-top:1.15rem}
.wx-mlp__calc-out>div{background:var(--wx-surface);border:1px solid var(--wx-line);border-radius:var(--wx-radius-sm);padding:.7rem .8rem}
.wx-mlp__calc-out span{display:block;font-family:var(--wx-font-head);font-size:1.55rem;font-weight:700;letter-spacing:-.02em;color:var(--wx-accent-ink)}
.wx-mlp__calc-out small{display:block;color:var(--wx-muted);font-size:.75rem;margin-top:.15rem}
.wx-mlp__calc-note{margin:.9rem 0 0;font-size:.78rem;color:var(--wx-muted)}

/* progress + sticky CTA */
.wx-mlp__progress{position:fixed;top:0;left:0;right:0;height:3px;background:transparent;z-index:60;pointer-events:none}
.wx-mlp__progress-bar{height:100%;width:0;background:linear-gradient(90deg,var(--wx-accent),var(--wx-plum))}
.wx-mlp__sticky{position:fixed;left:0;right:0;bottom:0;z-index:70;display:flex;align-items:center;gap:.7rem;justify-content:center;
  padding:.7rem 1rem;background:linear-gradient(135deg,var(--wx-accent-soft) 0%,var(--wx-surface) 58%,var(--wx-plum-soft) 100%);
  border-top:1px solid var(--wx-line);box-shadow:0 -8px 26px rgba(28,29,29,.14);transform:translateY(110%);transition:transform .2s ease}
.wx-mlp__sticky::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;
  background:linear-gradient(90deg,var(--wx-accent),var(--wx-plum))}
.wx-mlp__sticky.is-visible{transform:translateY(0)}
.wx-mlp__sticky .wx-mlp__btn--primary{box-shadow:none;padding:.7rem 1.15rem}
.wx-mlp__sticky-close{background:none;border:0;font-size:1.4rem;line-height:1;color:var(--wx-muted);cursor:pointer;padding:.1rem .45rem}
.wx-mlp__sticky-close:hover{color:var(--wx-ink)}

/* faq, links, footer — the question is now a <details>/<summary> row (see the FAQ block) */
.wx-mlp__links{font-size:.95rem;background:var(--wx-surface-warm);border:1px solid var(--wx-line);border-radius:var(--wx-radius);padding:1rem 1.15rem}
.wx-mlp__foot{color:var(--wx-muted);font-size:.82rem;letter-spacing:.02em}
.wx-mlp__hr{border:0;border-top:1px solid var(--wx-line);margin:2.2rem 0}
